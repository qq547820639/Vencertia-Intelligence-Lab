# Vencertia Adaptive Decision System v2.0.1 — environment sample
# Copy to .env or export in your shell; all variables are optional.
# Full Settings surface (P1-12): every field in vencertia/config.py is
# overridable via VENCERTIA_* environment variables.
#
# v2.0.1 (product ruling): the DEFAULT is the REAL AI path. mock is a
# test/development-only explicit opt-in and never selected implicitly.

# Persistence
VENCERTIA_DB_DSN=sqlite:///data/vencertia.db
# Leave empty to disable PostgreSQL backend.
VENCERTIA_PG_DSN=

# Model gateway (openai_compatible is the product default; mock = tests/dev only)
VENCERTIA_MODEL_PROVIDER=openai_compatible
VENCERTIA_OPENAI_BASE_URL=
VENCERTIA_OPENAI_API_KEY=
VENCERTIA_OPENAI_MODEL=gpt-4o-mini

# Search gateway (http is the product default and requires VENCERTIA_SEARCH_URL;
# mock = tests/dev only)
VENCERTIA_SEARCH_PROVIDER=http
VENCERTIA_SEARCH_URL=
VENCERTIA_SEARCH_API_KEY=
VENCERTIA_SEARCH_TIMEOUT=15.0

# Policy & engine knobs
VENCERTIA_POLICY_VERSION=1.0
VENCERTIA_LOG_LEVEL=INFO

# Engine defaults [H2]
VENCERTIA_MAX_PSEUDO_OBSERVATIONS=3.0
VENCERTIA_CONFLICT_WEIGHT_THRESHOLD=0.3
VENCERTIA_RISK_AVERSION=0.25
VENCERTIA_MINIMUM_MARGIN=0.08
VENCERTIA_MAX_CRITICAL_UNCERTAINTY=0.45
VENCERTIA_TRANSFERABILITY_THRESHOLD=0.6
VENCERTIA_EXPERIMENT_MAX_RESULTS=5
VENCERTIA_ECE_BINS=10

# Research pipeline
VENCERTIA_RESEARCH_MAX_QUESTIONS=3
VENCERTIA_RESEARCH_MAX_ROUNDS=3
VENCERTIA_RESEARCH_QUERIES_PER_ROUND=3
VENCERTIA_RESEARCH_STOP_MARGINAL_VALUE=0.02
VENCERTIA_RESEARCH_STOP_DUPLICATE_RATE=0.5

# Claim binding
VENCERTIA_BINDING_CONFIDENCE_THRESHOLD=0.6
VENCERTIA_BINDING_AUTO_RETRY=false
VENCERTIA_BINDING_MIN_SCORE=0.7
VENCERTIA_BINDING_AMBIGUITY_MARGIN=0.1
VENCERTIA_BINDING_REJECT_THRESHOLD=0.4

# Context ranking (comma-separated key=value overrides, e.g.
# decision_relevance=0.25,authority=0.10)
VENCERTIA_CONTEXT_RANK_WEIGHTS=
VENCERTIA_SEMANTIC_RANK_PROVIDER=deterministic

# Evidence pipeline
VENCERTIA_DEDUP_SIMILARITY_THRESHOLD=0.8
VENCERTIA_FRESHNESS_HALF_LIFE_DAYS=90.0

# Decision sensitivity
VENCERTIA_SENSITIVITY_STEP=0.01
VENCERTIA_ROBUSTNESS_MARGIN_THRESHOLD=0.05
VENCERTIA_FRAGILE_FLIP_THRESHOLD=0.10
VENCERTIA_FRAGILE_MARGIN=0.05
VENCERTIA_MODERATE_FLIP_THRESHOLD=0.25
VENCERTIA_MODERATE_MARGIN=0.12

# Provider resilience / observability
VENCERTIA_PROVIDER_MAX_RETRIES=2
VENCERTIA_PROVIDER_TIMEOUT_SECONDS=30.0
VENCERTIA_PROVIDER_RETRY_BACKOFF_BASE=0.5
VENCERTIA_CALL_LOG_ENABLED=true

# Optional engines (v1.1.2)
# OpportunityCostEngine: AVAILABLE ENGINE / NOT ACTIVE BY DEFAULT (P1-9).
VENCERTIA_OPPORTUNITY_COST_ENABLED=false

# Stakes / critic (v1.2; env-overridable since v1.9)
# Three-band ABSTAIN thresholds as JSON. Missing bands keep built-in defaults.
# VENCERTIA_STAKES_THRESHOLDS={"HIGH":{"minimum_margin":0.12,"max_critical_uncertainty":0.35},"MEDIUM":{"minimum_margin":0.08,"max_critical_uncertainty":0.45},"LOW":{"minimum_margin":0.04,"max_critical_uncertainty":0.60}}
# Mandatory model critic threshold: LOW | MEDIUM | HIGH (default HIGH).
VENCERTIA_CRITIC_REQUIRED_STAKES=HIGH

# L2 prospective prediction registry path (defaults to data/benchmarks/l2/predictions.jsonl)
# VENCERTIA_L2_REGISTRY_PATH=/var/lib/vencertia/l2/predictions.jsonl
