{
  "$defs": {
    "ConfidenceLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "FactStatus": {
      "enum": [
        "VERIFIED",
        "ESTIMATED",
        "ASSUMED",
        "UNKNOWN"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "ImportanceLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "ImportanceLevel",
      "type": "string"
    },
    "MemoryOperation": {
      "enum": [
        "WRITE",
        "MERGE",
        "SUPERSEDE",
        "CONFLICT",
        "REJECT",
        "EXPIRE",
        "ARCHIVE"
      ],
      "title": "MemoryOperation",
      "type": "string"
    },
    "MemoryRecord": {
      "additionalProperties": false,
      "description": "Canonical AgentV10.1 durable MemoryRecord.",
      "properties": {
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "user_id": {
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "structured_value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Value"
        },
        "source_message_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Message Ids",
          "type": "array"
        },
        "source_entity_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Entity Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fact_status": {
          "$ref": "#/$defs/FactStatus"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "importance": {
          "$ref": "#/$defs/ImportanceLevel"
        },
        "status": {
          "$ref": "#/$defs/MemoryStatus",
          "default": "ACTIVE"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "supersedes_memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Memory Id"
        },
        "conflicts_with_memory_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Conflicts With Memory Ids",
          "type": "array"
        }
      },
      "required": [
        "memory_id",
        "user_id",
        "scope",
        "memory_type",
        "content",
        "fact_status",
        "confidence",
        "importance",
        "created_at",
        "updated_at"
      ],
      "title": "MemoryRecord",
      "type": "object"
    },
    "MemoryScope": {
      "enum": [
        "USER_GLOBAL",
        "PROJECT_SPECIFIC"
      ],
      "title": "MemoryScope",
      "type": "string"
    },
    "MemoryStatus": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "CONFLICTED",
        "REJECTED",
        "EXPIRED",
        "ARCHIVED"
      ],
      "title": "MemoryStatus",
      "type": "string"
    },
    "MemoryType": {
      "enum": [
        "FOUNDER_FACT",
        "RESOURCE",
        "CAPABILITY",
        "CONSTRAINT",
        "RED_LINE",
        "PREFERENCE",
        "PROJECT_FACT",
        "PROJECT_DECISION",
        "ASSUMPTION",
        "EVIDENCE",
        "CUSTOMER_FEEDBACK",
        "EXPERIMENT_RESULT",
        "FINANCIAL_DATA",
        "RISK",
        "ACTION",
        "ACTION_RESULT",
        "MILESTONE",
        "OPEN_QUESTION",
        "EXCLUSION_RULE",
        "PIVOT_REASON",
        "LESSON"
      ],
      "title": "MemoryType",
      "type": "string"
    },
    "MemoryWriteResult": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/MemoryOperation"
        },
        "scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "target_memory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Memory Id"
        },
        "new_memory_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "affected_memory_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Memory Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "fact_status": {
          "$ref": "#/$defs/FactStatus"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "importance": {
          "$ref": "#/$defs/ImportanceLevel"
        },
        "snapshot_refresh_required": {
          "default": false,
          "title": "Snapshot Refresh Required",
          "type": "boolean"
        },
        "context_index_refresh_required": {
          "default": false,
          "title": "Context Index Refresh Required",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "operation",
        "scope",
        "memory_type",
        "reason",
        "fact_status",
        "confidence",
        "importance"
      ],
      "title": "MemoryWriteResult",
      "type": "object"
    },
    "RuntimeRefreshSignals": {
      "additionalProperties": false,
      "properties": {
        "founder_profile_refresh_required": {
          "default": false,
          "title": "Founder Profile Refresh Required",
          "type": "boolean"
        },
        "project_snapshot_refresh_required": {
          "default": false,
          "title": "Project Snapshot Refresh Required",
          "type": "boolean"
        },
        "context_refresh_required": {
          "default": false,
          "title": "Context Refresh Required",
          "type": "boolean"
        },
        "routing_reassessment_recommended": {
          "default": false,
          "title": "Routing Reassessment Recommended",
          "type": "boolean"
        },
        "state_reassessment_recommended": {
          "default": false,
          "title": "State Reassessment Recommended",
          "type": "boolean"
        }
      },
      "title": "RuntimeRefreshSignals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "user_id": {
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "candidate_count": {
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/MemoryWriteResult"
      },
      "title": "Results",
      "type": "array"
    },
    "conflicts_created": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Conflicts Created",
      "type": "array"
    },
    "supersessions_created": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Supersessions Created",
      "type": "array"
    },
    "rejected_candidates": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Rejected Candidates",
      "type": "array"
    },
    "snapshot_refresh_required": {
      "default": false,
      "title": "Snapshot Refresh Required",
      "type": "boolean"
    },
    "context_refresh_required": {
      "default": false,
      "title": "Context Refresh Required",
      "type": "boolean"
    },
    "write_confidence": {
      "$ref": "#/$defs/ConfidenceLevel",
      "default": "HIGH"
    },
    "runtime_refresh_signals": {
      "$ref": "#/$defs/RuntimeRefreshSignals"
    }
  },
  "required": [
    "request_id",
    "user_id",
    "candidate_count"
  ],
  "title": "MemoryWriteEvaluation",
  "type": "object"
}
