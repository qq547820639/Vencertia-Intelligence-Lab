{
  "$defs": {
    "AccessClass": {
      "enum": [
        "PRIVATE",
        "INTERNAL",
        "MATCHABLE",
        "PUBLIC"
      ],
      "title": "AccessClass",
      "type": "string"
    },
    "AgentId": {
      "enum": [
        "A0_ORCHESTRATOR",
        "A1_FOUNDER_DIAGNOSIS",
        "A2_MARKET_OPPORTUNITY",
        "A3_VENTURE_DESIGN",
        "A4_PROJECT_PROSECUTOR",
        "A5_FINANCIAL_BUSINESS_MODEL",
        "A6_EXECUTION_STRATEGY",
        "A7_NEXT_ACTION",
        "A8_STARTUP_CASE_INTELLIGENCE",
        "A9_FOUNDER_MATCHMAKING",
        "A10_BUSINESS_PLAN"
      ],
      "title": "AgentId",
      "type": "string"
    },
    "ConfidenceLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "FactStatus": {
      "enum": [
        "VERIFIED",
        "ESTIMATED",
        "ASSUMED",
        "UNKNOWN"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "ImportanceLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "ImportanceLevel",
      "type": "string"
    },
    "MemoryCandidate": {
      "additionalProperties": false,
      "description": "Canonical AgentV10.1 durable-memory candidate DTO.",
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "proposed_scope": {
          "$ref": "#/$defs/MemoryScope"
        },
        "proposed_memory_type": {
          "$ref": "#/$defs/MemoryType"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "structured_value": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structured Value"
        },
        "source_message_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Message Ids",
          "type": "array"
        },
        "source_entity_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Entity Ids",
          "type": "array"
        },
        "fact_status": {
          "$ref": "#/$defs/FactStatus",
          "default": "UNKNOWN"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel",
          "default": "MEDIUM"
        },
        "importance": {
          "$ref": "#/$defs/ImportanceLevel",
          "default": "MEDIUM"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "reason_to_remember": {
          "minLength": 1,
          "title": "Reason To Remember",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "proposed_scope",
        "proposed_memory_type",
        "content",
        "reason_to_remember"
      ],
      "title": "MemoryCandidate",
      "type": "object"
    },
    "MemoryScope": {
      "enum": [
        "USER_GLOBAL",
        "PROJECT_SPECIFIC"
      ],
      "title": "MemoryScope",
      "type": "string"
    },
    "MemoryType": {
      "enum": [
        "FOUNDER_FACT",
        "RESOURCE",
        "CAPABILITY",
        "CONSTRAINT",
        "RED_LINE",
        "PREFERENCE",
        "PROJECT_FACT",
        "PROJECT_DECISION",
        "ASSUMPTION",
        "EVIDENCE",
        "CUSTOMER_FEEDBACK",
        "EXPERIMENT_RESULT",
        "FINANCIAL_DATA",
        "RISK",
        "ACTION",
        "ACTION_RESULT",
        "MILESTONE",
        "OPEN_QUESTION",
        "EXCLUSION_RULE",
        "PIVOT_REASON",
        "LESSON"
      ],
      "title": "MemoryType",
      "type": "string"
    },
    "ProperStore": {
      "enum": [
        "STABLE_MEMORY",
        "FOUNDER_PROFILE",
        "PROJECT_KB",
        "EVIDENCE_LEDGER",
        "ASSUMPTION_LEDGER",
        "EXPERIMENT_LEDGER",
        "ACTION_LEDGER",
        "DECISION_LEDGER",
        "FINANCIAL_SNAPSHOT",
        "CUSTOMER_FEEDBACK",
        "STARTUP_INTELLIGENCE"
      ],
      "title": "ProperStore",
      "type": "string"
    },
    "SourceType": {
      "enum": [
        "USER_EXPLICIT_INPUT",
        "USER_CORRECTION",
        "CUSTOMER_FEEDBACK",
        "EXPERIMENT_RESULT",
        "REAL_PAYMENT",
        "PROJECT_DECISION",
        "AGENT_INFERENCE",
        "DOCUMENT_CLAIM",
        "WEB_SOURCE",
        "SYSTEM_DERIVED",
        "TOOL_RESULT"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Runtime-only metadata around a canonical MemoryCandidate.\n\nThis is intentionally not a new canonical knowledge entity.",
  "properties": {
    "candidate": {
      "$ref": "#/$defs/MemoryCandidate"
    },
    "source_types": {
      "items": {
        "$ref": "#/$defs/SourceType"
      },
      "title": "Source Types",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "semantic_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Key"
    },
    "proper_store": {
      "$ref": "#/$defs/ProperStore",
      "default": "STABLE_MEMORY"
    },
    "access_class": {
      "$ref": "#/$defs/AccessClass",
      "default": "PRIVATE"
    },
    "origin_agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "candidate"
  ],
  "title": "MemoryCandidateEnvelope",
  "type": "object"
}
