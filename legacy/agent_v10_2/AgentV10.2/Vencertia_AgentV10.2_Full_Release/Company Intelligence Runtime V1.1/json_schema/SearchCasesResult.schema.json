{
  "$defs": {
    "CaseDataQuality": {
      "additionalProperties": false,
      "properties": {
        "fact_status": {
          "$ref": "#/$defs/FactStatus"
        },
        "intelligence_status": {
          "$ref": "#/$defs/IntelligenceStatus"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "completeness": {
          "$ref": "#/$defs/Confidence"
        },
        "last_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified At"
        }
      },
      "required": [
        "fact_status",
        "intelligence_status",
        "confidence",
        "completeness"
      ],
      "title": "CaseDataQuality",
      "type": "object"
    },
    "CaseRole": {
      "enum": [
        "SUCCESS",
        "DURABLE_PROFIT",
        "FAILURE",
        "PIVOT",
        "RESTRUCTURING",
        "BENCHMARK",
        "ADJACENT",
        "ANTI_PATTERN"
      ],
      "title": "CaseRole",
      "type": "string"
    },
    "CaseUnitRef": {
      "additionalProperties": false,
      "description": "The canonical comparison unit: company x snapshot x scope.",
      "properties": {
        "company_id": {
          "pattern": "^CMP[0-9A-Za-z_-]+$",
          "title": "Company Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^BM[0-9A-Za-z_-]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "operating_segment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Operating Segment Ids",
          "type": "array"
        },
        "business_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Unit Id"
        },
        "offer_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Offer Ids",
          "type": "array"
        },
        "revenue_stream_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Revenue Stream Ids",
          "type": "array"
        },
        "customer_segment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Customer Segment Ids",
          "type": "array"
        },
        "geography": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Geography",
          "type": "array"
        },
        "valid_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Period"
        }
      },
      "required": [
        "company_id",
        "snapshot_id"
      ],
      "title": "CaseUnitRef",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EligibilityFlags": {
      "additionalProperties": false,
      "properties": {
        "fact_ready": {
          "default": false,
          "title": "Fact Ready",
          "type": "boolean"
        },
        "recommendation_ready": {
          "default": false,
          "title": "Recommendation Ready",
          "type": "boolean"
        },
        "financial_benchmark_ready": {
          "default": false,
          "title": "Financial Benchmark Ready",
          "type": "boolean"
        },
        "failure_benchmark_ready": {
          "default": false,
          "title": "Failure Benchmark Ready",
          "type": "boolean"
        },
        "pivot_benchmark_ready": {
          "default": false,
          "title": "Pivot Benchmark Ready",
          "type": "boolean"
        },
        "restructuring_benchmark_ready": {
          "default": false,
          "title": "Restructuring Benchmark Ready",
          "type": "boolean"
        },
        "gtm_benchmark_ready": {
          "default": false,
          "title": "Gtm Benchmark Ready",
          "type": "boolean"
        },
        "pricing_benchmark_ready": {
          "default": false,
          "title": "Pricing Benchmark Ready",
          "type": "boolean"
        }
      },
      "title": "EligibilityFlags",
      "type": "object"
    },
    "FactStatus": {
      "enum": [
        "NOT_READY",
        "FACT_READY",
        "FACT_VERIFIED"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "IntelligenceStatus": {
      "enum": [
        "NOT_REVIEWED",
        "GENERATED",
        "INTELLIGENCE_REVIEWED"
      ],
      "title": "IntelligenceStatus",
      "type": "string"
    },
    "RetrievalObjective": {
      "enum": [
        "GENERAL_RECOMMENDATION",
        "MARKET_PATTERN",
        "BUSINESS_MODEL",
        "INITIAL_WEDGE",
        "EARLY_GTM",
        "SCALED_GTM",
        "PRICING",
        "FINANCIAL_BENCHMARK",
        "CASHFLOW",
        "CONTRACT_RISK",
        "DELIVERY_MODEL",
        "OPERATING_LEVERAGE",
        "RETENTION_GROWTH",
        "FAILURE_PATTERN",
        "ANTI_PATTERN",
        "PIVOT_PATTERN",
        "RESTRUCTURING_PATTERN",
        "COMPANY_DEEP_DIVE",
        "COMPETITIVE_CASE_SET",
        "FOUNDER_MARKET_FIT"
      ],
      "title": "RetrievalObjective",
      "type": "string"
    },
    "SearchCandidate": {
      "additionalProperties": false,
      "properties": {
        "case_unit_ref": {
          "$ref": "#/$defs/CaseUnitRef"
        },
        "retrieval_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Retrieval Score",
          "type": "number"
        },
        "objective_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Score"
        },
        "scope_compatible": {
          "title": "Scope Compatible",
          "type": "boolean"
        },
        "time_compatible": {
          "title": "Time Compatible",
          "type": "boolean"
        },
        "eligibility": {
          "$ref": "#/$defs/EligibilityFlags"
        },
        "data_quality": {
          "$ref": "#/$defs/CaseDataQuality"
        },
        "case_roles": {
          "items": {
            "$ref": "#/$defs/CaseRole"
          },
          "title": "Case Roles",
          "type": "array"
        },
        "short_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Reason"
        }
      },
      "required": [
        "case_unit_ref",
        "retrieval_score",
        "scope_compatible",
        "time_compatible",
        "eligibility",
        "data_quality"
      ],
      "title": "SearchCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "retrieval_objective": {
      "$ref": "#/$defs/RetrievalObjective"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/SearchCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "retrieval_warnings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Retrieval Warnings",
      "type": "array"
    },
    "counterexample_count": {
      "default": 0,
      "minimum": 0,
      "title": "Counterexample Count",
      "type": "integer"
    }
  },
  "required": [
    "retrieval_objective",
    "candidates"
  ],
  "title": "SearchCasesResult",
  "type": "object"
}