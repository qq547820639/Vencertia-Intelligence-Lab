{
  "$defs": {
    "CaseDataQuality": {
      "additionalProperties": false,
      "properties": {
        "fact_status": {
          "$ref": "#/$defs/FactStatus"
        },
        "intelligence_status": {
          "$ref": "#/$defs/IntelligenceStatus"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "completeness": {
          "$ref": "#/$defs/Confidence"
        },
        "last_verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Verified At"
        }
      },
      "required": [
        "fact_status",
        "intelligence_status",
        "confidence",
        "completeness"
      ],
      "title": "CaseDataQuality",
      "type": "object"
    },
    "CaseUnitRef": {
      "additionalProperties": false,
      "description": "The canonical comparison unit: company x snapshot x scope.",
      "properties": {
        "company_id": {
          "pattern": "^CMP[0-9A-Za-z_-]+$",
          "title": "Company Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^BM[0-9A-Za-z_-]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "operating_segment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Operating Segment Ids",
          "type": "array"
        },
        "business_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Unit Id"
        },
        "offer_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Offer Ids",
          "type": "array"
        },
        "revenue_stream_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Revenue Stream Ids",
          "type": "array"
        },
        "customer_segment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Customer Segment Ids",
          "type": "array"
        },
        "geography": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Geography",
          "type": "array"
        },
        "valid_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Period"
        }
      },
      "required": [
        "company_id",
        "snapshot_id"
      ],
      "title": "CaseUnitRef",
      "type": "object"
    },
    "CaseVerdict": {
      "enum": [
        "HIGHLY_RELEVANT",
        "RELEVANT",
        "ADJACENT",
        "COUNTEREXAMPLE",
        "WEAK_REFERENCE",
        "DO_NOT_USE"
      ],
      "title": "CaseVerdict",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "ContextCase": {
      "additionalProperties": false,
      "properties": {
        "case_unit_ref": {
          "$ref": "#/$defs/CaseUnitRef"
        },
        "one_line_case": {
          "minLength": 1,
          "title": "One Line Case",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/CaseVerdict"
        },
        "relevant_facts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Relevant Facts",
          "type": "array"
        },
        "similarities": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Similarities",
          "type": "array"
        },
        "critical_differences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Critical Differences",
          "type": "array"
        },
        "transferable_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Transferable Patterns",
          "type": "array"
        },
        "anti_patterns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Anti Patterns",
          "type": "array"
        },
        "allowed_uses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        },
        "prohibited_uses": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prohibited Uses",
          "type": "array"
        },
        "data_quality": {
          "$ref": "#/$defs/CaseDataQuality"
        },
        "trace_refs": {
          "$ref": "#/$defs/TraceRefs"
        }
      },
      "required": [
        "case_unit_ref",
        "one_line_case",
        "verdict",
        "data_quality",
        "trace_refs"
      ],
      "title": "ContextCase",
      "type": "object"
    },
    "FactStatus": {
      "enum": [
        "NOT_READY",
        "FACT_READY",
        "FACT_VERIFIED"
      ],
      "title": "FactStatus",
      "type": "string"
    },
    "IntelligenceStatus": {
      "enum": [
        "NOT_REVIEWED",
        "GENERATED",
        "INTELLIGENCE_REVIEWED"
      ],
      "title": "IntelligenceStatus",
      "type": "string"
    },
    "ProjectContextSummary": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "primary_bottleneck": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Bottleneck"
        },
        "evidence_summary": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Summary",
          "type": "array"
        },
        "constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "project_id"
      ],
      "title": "ProjectContextSummary",
      "type": "object"
    },
    "RetrievalObjective": {
      "enum": [
        "GENERAL_RECOMMENDATION",
        "MARKET_PATTERN",
        "BUSINESS_MODEL",
        "INITIAL_WEDGE",
        "EARLY_GTM",
        "SCALED_GTM",
        "PRICING",
        "FINANCIAL_BENCHMARK",
        "CASHFLOW",
        "CONTRACT_RISK",
        "DELIVERY_MODEL",
        "OPERATING_LEVERAGE",
        "RETENTION_GROWTH",
        "FAILURE_PATTERN",
        "ANTI_PATTERN",
        "PIVOT_PATTERN",
        "RESTRUCTURING_PATTERN",
        "COMPANY_DEEP_DIVE",
        "COMPETITIVE_CASE_SET",
        "FOUNDER_MARKET_FIT"
      ],
      "title": "RetrievalObjective",
      "type": "string"
    },
    "TraceRefs": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": {
            "pattern": "^C[0-9A-Za-z_-]+$",
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^E[0-9A-Za-z_-]+$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "source_ids": {
          "items": {
            "pattern": "^S[0-9A-Za-z_-]+$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "title": "TraceRefs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "retrieval_objective": {
      "$ref": "#/$defs/RetrievalObjective"
    },
    "target_project_summary": {
      "$ref": "#/$defs/ProjectContextSummary"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ContextCase"
      },
      "maxItems": 6,
      "title": "Cases",
      "type": "array"
    },
    "counterexamples": {
      "items": {
        "$ref": "#/$defs/ContextCase"
      },
      "maxItems": 3,
      "title": "Counterexamples",
      "type": "array"
    },
    "cross_case_patterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Cross Case Patterns",
      "type": "array"
    },
    "cross_case_disagreements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Cross Case Disagreements",
      "type": "array"
    },
    "context_generated_at": {
      "format": "date-time",
      "title": "Context Generated At",
      "type": "string"
    }
  },
  "required": [
    "retrieval_objective",
    "target_project_summary",
    "context_generated_at"
  ],
  "title": "CaseContextPack",
  "type": "object"
}